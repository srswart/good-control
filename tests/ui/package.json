{
  "name": "ui-tests",
  "version": "0.1.0",
  "description": "Automated UI tests using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:items": "playwright test tests/inventory/items.spec.ts",
    "test:stock": "playwright test tests/inventory/stock.spec.ts",
    "test:smoke": "playwright test tests/smoke.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.3.0"
  }
}

